# ===== RAGAS 실험실 설정 =====
# cp .env.example .env 후 아래 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# --- 1. 내 Dify 주소 (공유 링크의 앞부분) ---
# Dify 를 내 컴퓨터에서 Docker 로 띄웠다면 보통 http://localhost 입니다.
# 공유 링크가 http://localhost:8088/chat/xxxx 처럼 포트가 있으면 포트까지 적으세요.
DIFY_BASE_URL=http://localhost

# --- 2. 판사 LLM (RAGAS 채점용): OpenRouter ---
# https://openrouter.ai/keys 에서 만든 키를 넣으세요. (수업에서 받은 키가 있으면 그 키)
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_API_KEY=
# 수업 측정과 같은 판사입니다. 판사를 바꾸면 점수 기준이 달라지므로 전후 비교 중에는 바꾸지 마세요.
JUDGE_MODEL=anthropic/claude-sonnet-5

# --- 3. 임베딩 (Answer Relevancy 계산용): 내 컴퓨터의 Ollama ---
# 먼저 `ollama pull bge-m3` 를 실행하세요. Dify 에 쓰는 임베딩 모델(예: nomic-embed-text)을 그대로 써도 됩니다.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# --- 4. 실행 옵션 ---
BIND_HOST=127.0.0.1
PORT=8030
MAX_QUESTIONS=10
WORKERS=1

# --- 5. 수업 서버로 여러 학생이 함께 쓸 때만 (혼자 쓰면 비워 두세요) ---
# CLASS_CODE 를 비우면 로그인 화면과 하루 실행 한도가 없습니다.
CLASS_CODE=
TEACHER_CODE=
RUNS_PER_DAY=3
